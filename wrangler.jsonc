{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova-new",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "2da3b1c5-404a-4a91-b3aa-7d92ab4c0160","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "52aef176b7cf4375bb79d1975832327e" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
